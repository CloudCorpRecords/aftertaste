# Copy to .env or export in your shell. ALL of this is optional —
# with no key the app runs in SAMPLE DATA mode (local taste-graph stand-in).

# Your event-issued Qloo credential (get it via the form linked at
# https://qloo.devpost.com/resources — "FIRST, get your API key").
# Setting this ONE line switches the app to the live Qloo Taste AI API.
QLOO_API_KEY=

# Optional: override the API base (e.g. https://staging.api.qloo.com).
QLOO_API_BASE=https://api.qloo.com

# Optional: server port (default 4173).
PORT=4173
